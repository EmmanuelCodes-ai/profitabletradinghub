# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL of the deployed application (e.g. https://profitabletradinghub.org)
APP_URL="https://profitabletradinghub.org"

# Resend API Key for automatic transaction and payment confirmation emails
# Get your free key at https://resend.com
RESEND_API_KEY="re_123456789"

# Verified sender email address (e.g. onboarding@profitabletradinghub.org)
EMAIL_FROM="Profitable Trading Hub <onboarding@profitabletradinghub.org>"

# Destination URL for the "Send Proof of Payment" email button (Telegram Desk)
# Defaults to https://t.me/PTHubDeskSupport or your personal telegram username
PROOF_SUBMISSION_URL="https://t.me/PTHubDeskSupport"

# Optional: Admin email address to receive copy of enrollment and payment alerts
ADMIN_NOTIFICATION_EMAIL="admin@profitabletradinghub.org"
